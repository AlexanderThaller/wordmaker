{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-clickhouse-datasource",
      "name": "ClickHouse",
      "version": "4.0.0"
    }
  ],
  "uid": "wordmaker-analytics",
  "title": "Wordmaker analytics",
  "description": "Page views of all wordmaker instances writing to one ClickHouse database.",
  "tags": [
    "wordmaker",
    "clickhouse"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "ClickHouse",
        "query": "grafana-clickhouse-datasource",
        "refresh": 1,
        "hide": 0,
        "current": {}
      },
      {
        "type": "textbox",
        "name": "database",
        "label": "Database",
        "query": "wordmaker",
        "current": {
          "text": "wordmaker",
          "value": "wordmaker"
        },
        "hide": 0
      },
      {
        "type": "query",
        "name": "site",
        "label": "Site",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "${datasource}"
        },
        "query": "SELECT DISTINCT site FROM ${database}.page_views WHERE $__timeFilter(timestamp) ORDER BY site",
        "definition": "SELECT DISTINCT site FROM ${database}.page_views WHERE $__timeFilter(timestamp) ORDER BY site",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Page views",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT count() FROM ${database}.page_views WHERE $__timeFilter(timestamp) AND site IN (${site:singlequote}) AND NOT is_bot AND status = 200",
          "format": 1,
          "queryType": "table"
        }
      ],
      "description": "Successful page views by people; bots are counted separately.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Visitors per day",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT sum(visitors) / greatest(1, dateDiff('day', toDate($__fromTime), toDate($__toTime)) + 1)\nFROM (SELECT toDate(timestamp) AS day, site, uniq(visitor_id) AS visitors\n      FROM ${database}.page_views WHERE $__timeFilter(timestamp) AND site IN (${site:singlequote}) AND NOT is_bot AND status = 200 GROUP BY day, site)",
          "format": 1,
          "queryType": "table"
        }
      ],
      "description": "Average over the days of the time range. A visitor ID only lasts a UTC day, so visitors cannot be counted over longer periods.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bot views",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT countIf(is_bot) FROM ${database}.page_views WHERE $__timeFilter(timestamp) AND site IN (${site:singlequote})",
          "format": 1,
          "queryType": "table"
        }
      ],
      "description": "Crawlers and other programs; see Bots below.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Not found",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT countIf(NOT is_bot AND status = 404) FROM ${database}.page_views WHERE $__timeFilter(timestamp) AND site IN (${site:singlequote})",
          "format": 1,
          "queryType": "table"
        }
      ],
      "description": "Page views that answered 404, e.g. broken links.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Sites",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT uniqExact(site) FROM ${database}.page_views WHERE $__timeFilter(timestamp) AND site IN (${site:singlequote})",
          "format": 1,
          "queryType": "table"
        }
      ],
      "description": "Wordmaker instances with page views in the time range.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Page views",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time, site, count() AS views\nFROM ${database}.page_views\nWHERE $__timeFilter(timestamp) AND site IN (${site:singlequote}) AND NOT is_bot AND status = 200\nGROUP BY time, site\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
      "maxDataPoints": 60,
      "interval": "15m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.site}",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Sites",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT site AS Site,\n  countIf(NOT is_bot AND status = 200) AS \"Page views\",\n  countIf(is_bot) AS \"Bot views\",\n  countIf(NOT is_bot AND status = 404) AS \"Not found\",\n  max(timestamp) AS \"Last view\"\nFROM ${database}.page_views\nWHERE $__timeFilter(timestamp)\nGROUP BY site\nORDER BY \"Page views\" DESC",
          "format": 1,
          "queryType": "table"
        }
      ],
      "description": "Every instance, whatever is selected above. Click a site to show only it.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Site"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only this site",
                    "url": "/d/${__dashboard.uid}?var-site=${__value.raw}&${__url_time_range}&${database:queryparam}&${datasource:queryparam}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Page views"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last view"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Visitors",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "geomap",
      "title": "Page views by country",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 16,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT country_code, any(country) AS country, count() AS views\nFROM ${database}.page_views\nWHERE $__timeFilter(timestamp) AND site IN (${site:singlequote}) AND NOT is_bot AND status = 200 AND country_code != ''\nGROUP BY country_code\nORDER BY views DESC",
          "format": 1,
          "queryType": "table"
        }
      ],
      "description": "Countries from the GeoIP database the instances use.",
      "options": {
        "view": {
          "id": "zero",
          "lat": 25,
          "lon": 10,
          "zoom": 1.4,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false,
          "showAttribution": true
        },
        "basemap": {
          "type": "geojson",
          "name": "Countries",
          "config": {
            "src": "public/maps/countries.geojson",
            "rules": [],
            "style": {
              "color": {
                "fixed": "#8e8e8e"
              },
              "opacity": 0.15,
              "lineWidth": 1
            }
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "Page views",
            "tooltip": true,
            "location": {
              "mode": "lookup",
              "lookup": "country_code",
              "gazetteer": "public/gazetteer/countries.json"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "field": "views",
                  "min": 4,
                  "max": 30,
                  "fixed": 5
                },
                "color": {
                  "field": "views",
                  "fixed": "blue"
                },
                "opacity": 0.6,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Countries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT if(country = '', 'Unknown', country) AS name, count() AS views, uniq(visitor_id) AS visitors\nFROM ${database}.page_views\nWHERE $__timeFilter(timestamp) AND site IN (${site:singlequote}) AND NOT is_bot AND status = 200\nGROUP BY name\nORDER BY views DESC, name\nLIMIT 10",
          "format": 1,
          "queryType": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Country"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "views"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Page views"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "visitors"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Visitors"
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Pages",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT concat(site, path) AS name, count() AS views, uniq(visitor_id) AS visitors\nFROM ${database}.page_views\nWHERE $__timeFilter(timestamp) AND site IN (${site:singlequote}) AND NOT is_bot AND status = 200\nGROUP BY name\nORDER BY views DESC, name\nLIMIT 15",
          "format": 1,
          "queryType": "table"
        }
      ],
      "description": "Full URLs, so pages of different sites stay apart.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Page"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "views"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Page views"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "visitors"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Visitors"
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Referrers",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "rawSql": "SELECT referrer_host AS name, count() AS views, uniq(visitor_id) AS visitors\nFROM ${database}.page_views\nWHERE $__timeFilter(timestamp) AND site IN (${site:singlequote}) AND NOT is_bot AND status = 200 AND referrer_host != '' AND referrer_host != domain(site)\nGROUP BY name\nORDER BY views DESC, name\nLIMIT 15",
          "format": 1,
          "queryType": "table"
        }
      ],
      "description": "Other sites visitors came from.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Referrer"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "views"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Page views"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "visitors"
            },
            "properties": [
